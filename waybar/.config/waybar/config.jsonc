{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 6,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "spacing": 0,

  "modules-left": [
    "custom/launcher",
    "clock",
    "hyprland/language",
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "battery"
  ],

  "custom/launcher": {
    "format": " Apps",
    "on-click": "wofi --show drun --insensitive",
    "tooltip": false
  },

  "clock": {
    "format": "{:%H:%M %a}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 4
    }
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  "network": {
    "format-wifi": " {icon}  {signalStrength}%",
    "format-ethernet": " 󰈀",
    "format-disconnected": " 󰖪",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{ifname} via {gwaddr}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"

  },
  "hyprland/language": {
    "format": "{short}",
    "on-click": "hyprctl switchxkblayout current next"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "on-click": "/home/ludwig/.config/waybar/scripts/power-menu.sh"
  }
}
